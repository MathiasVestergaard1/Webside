
@inherits LayoutComponentBase

<div class="page">

    <!-- Sidebar -->
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>

        <!-- Top Header -->
        <header class="top-row">

            <!-- Login / Account UI -->
            <AccountBar />

        </header>

        <!-- Page Content -->
        <article class="content">
            @Body
        </article>

    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
