@if (Error is not null)
{
    <p class="alert alert-danger" role="alert">@Message</p>
}

@code {
    [Parameter] public string? Error { get; set; }
    private string Message => Error switch
    {
        "credentials" => "Incorrect username or password.",
        "duplicate" => "Username or email is already in use.",
        "database" => "Could not connect to the user database. Please try again later.",
        _ => "Check the fields. Your password must be 12–128 characters and both passwords must match."
    };
}
