@page "/login"
<PageTitle>Log in</PageTitle>
<h1>Log in</h1>
<AccountMessage Error="@Error" />
<p>Log in using the fields at the top of the page. <a href="/register">Create account</a>, if you do not have an account.</p>
@code {
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
}
