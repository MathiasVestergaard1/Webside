@page "/weather"
@rendermode InteractiveServer
@using System.Globalization
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Weather</PageTitle>

<h1>Vejret</h1>

<p>Søg efter et sted.</p>

<div class="d-flex gap-2 mb-3">
    <input type="text"
           class="form-control"
           placeholder="Søg efter by..."
           @bind="searchText"
           @bind:event="oninput"
           @onkeydown="HandleKeyDown" />

    <button class="btn btn-primary" @onclick="SearchAsync" disabled="@isLoading">
        Søg
    </button>
</div>

@if (isLoading)
{
    <p><em>Henter vejrdata...</em></p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-warning">@errorMessage</div>
}
else if (location != null && forecasts != null)
{
    <h2>
        @location.Name
        <small class="text-muted">
            @string.Join(", ", new[] { location.Region, location.Country }.Where(s => !string.IsNullOrEmpty(s)))
        </small>
    </h2>

    <table class="table">
        <thead>
            <tr>
                <th>Dato</th>
                <th>Gennemsnit</th>
                <th>Max</th>
                <th>Min</th>
                <th>Vind (m/s)</th>
                <th>Vejrforhold</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var day in forecasts)
            {
                <tr>
                    <td>@day.Date.ToString("dddd d. MMM", daCulture)</td>
                    <td>@day.TempMean.ToString("F1", daCulture) °C</td>
                    <td>@day.TempMax.ToString("F1", daCulture) °C</td>
                    <td>@day.TempMin.ToString("F1", daCulture) °C</td>
                    <td>@day.WindSpeed.ToString("F1", daCulture)</td>
                    <td>@day.Condition</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private static readonly CultureInfo daCulture = new("da-DK");

    private string searchText = "";
    private bool isLoading;
    private string? errorMessage;

    private GeocodingResult? location;
    private List<DayForecast>? forecasts;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        var query = searchText.Trim();
        if (string.IsNullOrEmpty(query) || isLoading)
        {
            return;
        }

        isLoading = true;
        errorMessage = null;
        location = null;
        forecasts = null;

        try
        {
            var client = HttpClientFactory.CreateClient();

            // 1. Find the city
            var geoUrl = "https://geocoding-api.open-meteo.com/v1/search" +
                         $"?name={Uri.EscapeDataString(query)}&count=1&language=da";

            var geo = await client.GetFromJsonAsync<GeocodingResponse>(geoUrl);
            var place = geo?.Results?.FirstOrDefault();

            if (place == null)
            {
                errorMessage = $"Kunne ikke finde et sted der hedder \"{query}\".";
                return;
            }

            // 2. Get the 5-day forecast
            var lat = place.Latitude.ToString(CultureInfo.InvariantCulture);
            var lon = place.Longitude.ToString(CultureInfo.InvariantCulture);

            var forecastUrl = "https://api.open-meteo.com/v1/forecast" +
                              $"?latitude={lat}&longitude={lon}" +
                              "&daily=weather_code,temperature_2m_max,temperature_2m_min,temperature_2m_mean,wind_speed_10m_max" +
                              "&wind_speed_unit=ms&timezone=auto&forecast_days=5";

            var forecast = await client.GetFromJsonAsync<ForecastResponse>(forecastUrl);
            var daily = forecast?.Daily;

            if (daily == null || daily.Time.Count == 0)
            {
                errorMessage = "Vejrdata kunne ikke hentes.";
                return;
            }

            forecasts = Enumerable.Range(0, daily.Time.Count)
                .Select(i => new DayForecast
                {
                    Date = DateOnly.Parse(daily.Time[i], CultureInfo.InvariantCulture),
                    TempMean = daily.TemperatureMean[i],
                    TempMax = daily.TemperatureMax[i],
                    TempMin = daily.TemperatureMin[i],
                    WindSpeed = daily.WindSpeedMax[i],
                    WeatherCode = daily.WeatherCode[i]
                })
                .ToList();

            location = place;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Der var et problem med at kontakte vejrtjenesten. Prøv igen senere.";
        }
        catch (Exception)
        {
            errorMessage = "Der opstod en uventet fejl.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
